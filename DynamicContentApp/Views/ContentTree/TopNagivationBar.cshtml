<script>
$(document).ready(function() {
    $('.menu-item').on('click', function() {
        const $this = $(this);
        const targetTrayId = $this.data('target');
        const $targetTrayContent = $('#' + targetTrayId);
        const $trayContainer = $('.tray-container');

        // Case 1: Clicking an already active tab - Close the tray
        if ($this.hasClass('active')) {
            $this.removeClass('active');
            $trayContainer.slideUp(300, function() {
                $('.tray-content').hide();
            });
            return;
        }

        // Case 2: Switching tabs or opening for the first time
        $('.menu-item').removeClass('active');
        $this.addClass('active');

        if ($trayContainer.is(':visible')) {
            // Smoothly crossfade tray content if container is already open
            $('.tray-content').fadeOut(150, function() {
                $targetTrayContent.css('display', 'flex').fadeIn(150);
            });
        } else {
            // Open container and display tray content using flexbox
            $targetTrayContent.css('display', 'flex');
            $trayContainer.slideDown(300);
        }
    });
});
</script>
