<script>
    $(function () {
        let zIndexCounter = 100;
        let maximized = {};

        // Initialize windows
        $(".window").each(function () {
            let win = $(this);
            let id = win.attr("id");
            let title = win.find(".window-title").text();

            // Make draggable & resizable
            win.draggable({
                handle: ".window-header",
                containment: "body",
                stack: ".window"
            }).resizable({
                minWidth: 300,
                minHeight: 250
            });

            // Create taskbar button
            let btn = $("<div class='taskbar-button' style='display:none;'></div>").text(title).attr("data-win", id);
            $("#taskbar").append(btn);

            // Taskbar button click
            btn.on("click", function () {
                if (win.is(":visible")) {
                    win.hide();
                } else {
                    bringToFront(win);
                    win.show();
                }
            });

            // Minimize
            win.find(".min-btn").on("click", function () {
                win.hide();
            });

            // Maximize / Restore
            win.find(".max-btn").on("click", function () {
                if (!maximized[id]) {
                    maximized[id] = {
                        top: win.css("top"),
                        left: win.css("left"),
                        width: win.css("width"),
                        height: win.css("height")
                    };
                    win.css({
                        top: 0,
                        left: 0,
                        width: "100%",
                        height: "calc(100% - 40px)"
                    });
                } else {
                    win.css(maximized[id]);
                    delete maximized[id];
                }
            });

            // Close
            win.find(".close-btn").on("click", function () {
                //win.remove();
                win.hide("slow");
                //btn.remove();
                btn.hide("slow");

            });

            // Bring to front on click
            win.on("mousedown", function () {
                bringToFront(win);
            });
        });

        function bringToFront(win) {
            $(".window").css("z-index", 100);
            win.css("z-index", ++zIndexCounter);
        }

    });
</script>


