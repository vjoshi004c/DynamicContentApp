<script>
    $(function () {
        // Toggle Start menu
        $(".start-btn").click(function () {
            $(".start-menu").toggle();
        });
        $(".SignOff-btn").click(function () {
           var CurrnetDomainUrl = document.getElementById("hdn_CurrnetDomainUrl").value;
           //alert(CurrnetDomainUrl);
            window.location.href =  CurrnetDomainUrl+ "/login";
        });
        // Close start menu when clicking outside
        $(document).click(function (e) {
            if (!$(e.target).closest('.start-btn, .start-menu').length) {
                $(".start-menu").hide();
            }
        });

        // Open app from desktop icon or start menu
        $(".icon, .start-menu li").click(function () {

             

            let app = $(this).data("app");
            //alert("Opening " + app + "...");
            openApp(app);
            $(".start-menu").hide();
        });

