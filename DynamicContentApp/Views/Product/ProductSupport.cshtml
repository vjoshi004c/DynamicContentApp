@* <h1> Product Support</h1>
<h6> Need help managing your content? Our dedicated CMS support team ensures your product pages, specifications, and 
    media are always accurate, optimized, and up-to-date. From troubleshooting technical issues t
    o guiding you through best practices, we’re here to keep your content running smoothly—so you can focus on growing your business.</h6> *@

    <div class="container px-4 py-5" id="featured-3">
        <h2 class="pb-2 border-bottom" style="color:#05507D!important">@Model.HeaderTitle</h2>
        <h6 style="padding-bottom:40px;color:#05507D!important">  @Model.LongtDescription</h6>
        <div class="row g-4 py-5 row-cols-1 row-cols-lg-3" style="background-color:#DCDFE0!important;"    >
         
           @if (Model.SupportOption != null || Model.SupportOption.Count>0)
                            {
                                @foreach (var item in Model.SupportOption)
                            {
                                <div class="feature col">
                    <div class="feature-icon d-inline-flex align-items-center justify-content-center text-bg-primary bg-gradient fs-2 mb-3" style="background-color:#DCDFE0!important">
                              <svg class="bi" width="1em" height="1em" aria-hidden="true">
                                <use xlink:href="#collection"></use>
                              </svg>
                              <img src="@item.ProductSupportImage.File" alt="Bootstrap" width="20%" height="auto" class="rounded-circle border border-white" style="border-radius: 10% !important;"/>
                            </div>
                            <h3 class="fs-2 text-body-emphasis" style="color:#05507D!important">
                                @item.HeaderTitle </h3>
                            <p style="color:#05507D!important">
                             @item.LongtDescription
                            </p>
                    <a href="@item.ProductSupportLink.AssetPath" class="btn btn-sm btn-outline-secondary" style="color:white;background-color: #0472B5 !important; border-color: #0472B5;">  Learn More</a>
                            @* <a href="@item.ProductSupportLink.AssetPath" class="icon-link" style="color:#05507D!important"   >
                              Call to action
                              <svg class="bi" aria-hidden="true">
                                <use xlink:href="#chevron-right"></use>
                              </svg>
                            </a> *@
                          </div>
                
                            }
                        }

  
            
        </div>
      </div>