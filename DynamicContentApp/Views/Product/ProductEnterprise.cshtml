      <section class="py-5 text-center container">
        <div class="row py-lg-5" style="padding-top:0px!important;padding-bottom:0px!important">
          <div class="col-lg-6 col-md-8 mx-auto">
            <h1 class="fw-light" style="color:#05507D !important;">
              <strong>@Model.HeaderTitle</strong>
            </h1>
            <p class="lead text-body-secondary" style="color:#05507D !important;font-weight: bold;">
              @Model.LongtDescription</p>
            <p>
              <a href="/UniversalCMS/Content/ProductWS/ProductFeatures" class="btn btn-primary my-2" style="background-color:#05507D!important;">Go to product featuress</a>
              <a href="/UniversalCMS/Content/ProductWS" class="btn btn-secondary my-2" style="background-color:#05507D!important;">Go back to homepage</a>
            </p>
          </div>
        </div>
      </section>
      <div class="album py-5 bg-body-tertiary" style="background-color: #0472B5 !important; ">
        <div class="container">
          <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">


                @if (Model.ProductFeatures != null || Model.ProductFeatures.Count>0)
                            {
                                @foreach (var item in Model.ProductFeatures)
                                {
                                    @*  @if (item.ProductTitle != null || !string.IsNullOrEmpty(item.ProductTitle))
                                     { *@
                                      
                                                       
                                    <div class="col">
                                      <div class="card shadow-sm">
                                        <svg
                                          aria-label="Placeholder: Thumbnail"
                                          class="bd-placeholder-img card-img-top"
                                          height="25"
                                          preserveAspectRatio="xMidYMid slice"
                                          role="img"
                                          width="100%"
                                          xmlns="http://www.w3.org/2000/svg"
                                        >
                                        <img src="@item.ProductImage.File"  style="width:50%;height:100%;" alt="Access Manager" class="img-fluid" />
                                          <title>Placeholder</title>
                                          <rect width="100%" height="100%" fill="#55595c"></rect>
                                          <text x="50%" y="50%" fill="#eceeef" dy=".3em">
                                            <strong style="color: #0472B5;">@item.ProductTitle  </strong>
                                          </text>
                                        </svg>
                                        <div class="card-body">
                                          <p class="card-text" style="color:#05507D !important;">
                                          @item.ProductDescription
                                          </p>

                                          <div
