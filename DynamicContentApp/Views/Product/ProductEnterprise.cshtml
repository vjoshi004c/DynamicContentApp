                                          <div
                                            class="d-flex justify-content-between align-items-center"
                                          >
                                            <div class="btn-group">
                                                 <a href="@item.ProductLink.AssetPath"  class="btn btn-sm btn-outline-secondary">  View</a>
                                           @*    <button
                                                type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                              >
                                                View
                                              </button> *@
                                             @*  <button
                                                type="button"
                                                class="btn btn-sm btn-outline-secondary"
