      <section class="py-5 text-center container">
        <div class="row py-lg-5" style="padding-top:0px!important;padding-bottom:0px!important">
          <div class="col-lg-6 col-md-8 mx-auto">
            <h1 class="fw-light" style="color:#05507D !important;">
              <strong>@Model.HeaderTitle</strong>
            </h1>
            <p class="lead text-body-secondary" style="color:#05507D !important;font-weight: bold;">
              @Model.LongtDescription</p>
            <p>
              <a href="/UniversalCMS/Content/ProductWS/ProductFeatures" class="btn btn-primary my-2" style="background-color:#05507D!important;">Go to product featuress</a>
              <a href="/UniversalCMS/Content/ProductWS" class="btn btn-secondary my-2" style="background-color:#05507D!important;">Go back to homepage</a>
            </p>
          </div>
        </div>
      </section>
      <div class="album py-5 bg-body-tertiary" style="background-color: #0472B5 !important; ">
