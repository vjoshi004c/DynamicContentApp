@* <h1> Product Tour</h1> *@

    <div class="container px-4 py-5" id="custom-cards">
        <h2 class="pb-2 border-bottom" style="color:#05507D!important">@Model.HeaderSubTitle  </h2>
        <h6 style="color:#05507D!important"> 
            @Model.LongtDescription
        </h6>

        <div class="row row-cols-1 row-cols-lg-3 align-items-stretch g-4 py-5">
             @if (Model.TourOption != null || Model.TourOption.Count>0)
                            {
                                @foreach (var item in Model.TourOption)
                                {
                                    
                                  <div class="col">
                                    <div
                                      class="card card-cover h-100 overflow-hidden text-bg-dark rounded-4 shadow-lg"
                                   style="background-image: ; background-color: #0472B5 !important"
                                    >
                                      <div
                                        class="d-flex flex-column h-100 p-5 pb-3 text-white text-shadow-1"
                                      >
                                        <h3 class="pt-5 mt-5 mb-4 display-6 lh-1 fw-bold" style="font-size: 2.0rem;">
                                            @item.HeaderTitle 
                                        </h3>
                                        <h3 class="pt-5 mt-5 mb-4 display-6 lh-1 " style="font-size: 1.5rem;">
                                            @item.LongtDescription
                                        </h3>
                                        <ul class="d-flex list-unstyled mt-auto">
                                          <li class="me-auto">
                                            <img
                                              @*src="https://github.com/twbs.png"*@
                                              src="@item.TourImage.File"
                                              alt="Bootstrap"
                                              width="132"
                                              height="132"
                                              class="rounded-circle border border-white" style="border-radius: 10% !important;"
                                            />
                                          </li>
                                          <li class="d-flex align-items-center me-3">
                                            <svg
                                              class="bi me-2"
                                              width="1em"
                                              height="1em"
                                              role="img"
                                              aria-label="Location"
                                            >
                                              <use xlink:href="#geo-fill"></use>
                                            </svg>
                                            <small><a href="@item.TourLink.AssetPath" style="color: white; text-decoration: underline;">View More</a></small>
                                          </li>
                                          @*<li class="d-flex align-items-center">
                                            <svg
                                              class="bi me-2"
                                              width="1em"
                                              height="1em"
                                              role="img"
                                              aria-label="Duration"
                                            >
                                              <use xlink:href="#calendar3"></use>
                                            </svg>
                                            <small>3d</small>
                                          </li> *@
                                        </ul>
                                      </div>
                                    </div>
                                  </div>
                
                                }
        }



       
        </div>
      </div>