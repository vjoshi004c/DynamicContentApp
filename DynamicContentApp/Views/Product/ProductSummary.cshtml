@* <h1> Product Summary</h1>
<h6>VPM Universal CMS– A user‑friendly Content Management System for easy website creation, content editing, and seamless publishing without
    coding. A flexible CMS platform for creating, editing, and publishing digital content across web and mobile.Build 
    and manage your website content easily with a simple, no‑code editor.</h1> *@

      <div class="container px-4 py-5" id="icon-grid">
        <h2 class="pb-2 border-bottom" style="color:#05507D!important">@Model.HeaderTitle</h2>
        <h6 style="height: 100px;color:#05507D!important" >
@Model.LongtDescription
</h1>
        <div
          class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 py-5"  style="background-color:#DCDFE0!important;"        >
           @if (Model.ProductFeatures != null || Model.ProductFeatures.Count>0)
                            {
                                @foreach (var item in Model.ProductFeatures)
                                    {
                                         <div class="col d-flex align-items-start">
                                <svg
                                  class="bi text-body-secondary flex-shrink-0 me-3"
                                  width="1.75em"
                                  height="1.75em"
                                  aria-hidden="true"
                                >
                                  <use xlink:href="#bootstrap"></use>
                                </svg>
                                <div>
                                  <h3 class="fw-bold mb-0 fs-4 text-body-emphasis" style="color:#05507D!important">
                                    @item.ProductTitle
                                  </h3>
                                  <p style="color:#05507D!important">
                                    @item.ProductDescription
                                  </p>
                                </div>
                              </div>
                                    }
                            } 
                  
          
          
        </div>
      </div>