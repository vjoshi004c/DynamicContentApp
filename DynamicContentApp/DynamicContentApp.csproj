    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Obfuscar" Version="3.0.0-beta.22">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
	<Target Name="ObfuscateRelease" AfterTargets="AfterBuild" Condition="'$(Configuration)' == 'Release'">
		<PropertyGroup>
			<ObfuscarExe>$(NugetPackageRoot)obfuscar\$(ObfuscarVersion)\tools\Obfuscar.Console.exe</ObfuscarExe>
			<!-- Fallback if NugetPackageRoot is not defined -->
			<ObfuscarExe Condition="!Exists('$(ObfuscarExe)')">$(UserProfile)\.nuget\packages\obfuscar\3.0.0-beta.22\tools\Obfuscar.Console.exe</ObfuscarExe>
		</PropertyGroup>
		<Message Text="Running Obfuscar code obfuscation..." Importance="high" />
		<!-- Create temporary folders and execute Obfuscar -->
		<Exec Command="&quot;$(ObfuscarExe)&quot; obfuscar.xml" />

		<!-- Copy obfuscated files back to the intermediate output directory -->
		<ItemGroup>
			<ObfuscatedFiles Include="Obfuscated\*.*" />
		</ItemGroup>
		<!--<Copy SourceFiles="@(ObfuscatedFiles)" DestinationFolder="$(ProjectDir)$(IntermediateOutputPath)" OverwriteReadOnlyFiles="true" />-->
